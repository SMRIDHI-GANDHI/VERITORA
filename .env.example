# ---- Backend ----
# NOTE: The backend uses the async SQLAlchemy driver (asyncpg).
# Keep DATABASE_URL in the postgresql+asyncpg:// format.
# Postgres 18 local: user/password/db = veritrust, host localhost, port 5432
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://veritrust:veritrust@localhost:5432/veritrust
SECRET_KEY=change-me-use-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=30
# Comma-separated. Outside APP_ENV=production the API also accepts any
# http://localhost:<port> / http://127.0.0.1:<port> origin (Vite port shifts).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=60/minute
# Optional: external LLM (rule engine and chatbot must work without it)
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional: verification sources (no key = check returns "not_checked")
SEARCH_API_KEY=
# Resource links are configurable; review before every release
CYBERCRIME_RESOURCES_FILE=app/config/cyber_resources_in.json
NETWORK_HMAC_KEY=change-me-network-hmac-key
# Offer-letter uploads (private storage, TTL-based cleanup)
OFFER_STORAGE_DIR=backend/storage/offer_letters
OFFER_FILE_TTL_HOURS=24
OFFER_MAX_UPLOAD_MB=5

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
