# VERITORA environment example (root reference)
# Copy values to the correct per-app env files and replace placeholders locally.
# Never commit real credentials, API keys, tokens, or DATABASE_URL secrets.
#
# Backend:
#   - Backend settings load from backend/.env when commands run from backend/.
#   - Copy backend/.env.example to backend/.env for local backend development.
#   - Use the async SQLAlchemy driver: postgresql+asyncpg:// (asyncpg required).
#
# Frontend:
#   - Vite reads VITE_* vars from frontend/.env or the frontend process environment.
#   - For local development you can set VITE_API_BASE_URL in frontend/.env or shell.

# ---- Backend (see backend/.env.example for backend-local usage) ----
# APP_ENV: development|dev|local|test use dev-friendly secret validation; production|prod require strong non-placeholder SECRET_KEY and NETWORK_HMAC_KEY.
APP_ENV=development
# PostgreSQL async connection URL (required). Examples (placeholders only):
#   Development: postgresql+asyncpg://<user>:<password>@localhost:5432/<db_name>
#   Test/CI DB: postgresql+asyncpg://<user>:<password>@localhost:5432/<test_db_name>
#   Production:  postgresql+asyncpg://<user>:<password>@<db-host>:5432/<db_name>
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
# JWT signing secret (>=16 chars). Required to be strong/non-placeholder outside dev/test/local/development.
SECRET_KEY=change-me-to-a-long-random-secret
# Access token lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=30
# Comma-separated allowed browser origins. Outside APP_ENV=production/prod the API also allows http://localhost:<port> and http://127.0.0.1:<port> for Vite port shifts.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default API rate limit (slowapi format).
RATE_LIMIT_DEFAULT=60/minute
# Optional LLM (disabled by default; rule engine/chat degraded mode must work without it).
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional verification/search integration key (no key => checks may return not_checked/inconclusive as applicable).
SEARCH_API_KEY=
# Config path for official cybercrime resources (served from config; review before release).
CYBERCRIME_RESOURCES_FILE=app/config/cyber_resources_in.json
# HMAC key for protected network identifiers. Required to be strong/non-placeholder outside dev/test/local/development.
NETWORK_HMAC_KEY=change-me-to-a-long-random-hmac-key
# Private offer-letter storage and retention/size controls.
OFFER_STORAGE_DIR=backend/storage/offer_letters
OFFER_FILE_TTL_HOURS=24
OFFER_MAX_UPLOAD_MB=5

# ---- Frontend ----
# Backend API base URL including /api/v1 (default in app: http://localhost:8000/api/v1).
VITE_API_BASE_URL=http://localhost:8000/api/v1
