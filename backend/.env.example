# Copy to `.env` in this directory and fill in real values.
# The backend loads `.env` from the directory it is started in (usually `backend/`),
# so run uvicorn/alembic from here:
#   cd backend && uvicorn app.main:app --reload
#   cd backend && alembic upgrade head
#
# NOTE: the async SQLAlchemy driver is required (asyncpg).

APP_ENV=development
DATABASE_URL=postgresql+asyncpg://veritrust:CHANGE_ME@localhost:5432/veritrust
SECRET_KEY=change-me-use-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=30
# Comma-separated. Outside APP_ENV=production the API also accepts any
# http://localhost:<port> / http://127.0.0.1:<port> origin (Vite port shifts).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=60/minute

# Optional: external LLM. The rule engine and the chatbot's templated
# responder must work with this disabled.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional: verification sources (no key = check returns "not_checked")
SEARCH_API_KEY=

# Official resource links; review before every release.
CYBERCRIME_RESOURCES_FILE=app/config/cyber_resources_in.json

# HMAC key used to hash identifiers in network detection entities.
NETWORK_HMAC_KEY=change-me-network-hmac-key

# Offer-letter uploads (private storage, TTL-based cleanup).
OFFER_STORAGE_DIR=backend/storage/offer_letters
OFFER_FILE_TTL_HOURS=24
OFFER_MAX_UPLOAD_MB=5
