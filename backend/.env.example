# Backend environment example (copy to backend/.env; never commit real secrets)
# Backend loads .env from the directory it is started in (usually backend/).
# Run backend commands from backend/, for example:
#   cd backend && uvicorn app.main:app --reload --port 8000
#   cd backend && alembic upgrade head
#
# Required driver: async SQLAlchemy with asyncpg. DATABASE_URL must use postgresql+asyncpg://

# APP_ENV controls environment behavior:
# - development/dev/local/test: dev-friendly secret validation (placeholders allowed for local dev/test only).
# - production/prod: SECRET_KEY and NETWORK_HMAC_KEY must be strong non-placeholder values or startup fails validation.
APP_ENV=development

# PostgreSQL async connection URL (required). Replace placeholders locally.
# Development example: postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>
# Test/CI DB example:  postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<test_db_name>
# Production example:  postgresql+asyncpg://<db_user>:<db_password>@<db-host>:5432/<db_name>
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>

# JWT signing secret (>=16 chars). Use a long random value in real environments.
SECRET_KEY=change-me-to-a-long-random-secret
# Access token lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=30

# Comma-separated allowed browser origins.
# Outside APP_ENV=production/prod the API also allows http://localhost:<port> and http://127.0.0.1:<port> (Vite port shifts).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default API rate limit (slowapi format), e.g. 60/minute.
RATE_LIMIT_DEFAULT=60/minute

# Optional LLM integration (disabled by default).
# Rule engine and grounded chatbot degraded/templated mode must work when LLM_ENABLED=false.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional external verification/search key.
# If not configured, related checks may return not_checked/inconclusive depending on the source/check.
SEARCH_API_KEY=

# Official cybercrime resources config path (served from config; review before every release).
CYBERCRIME_RESOURCES_FILE=app/config/cyber_resources_in.json

# HMAC key used to hash/protect network identifiers (ADR 0006). Use a long random value in real environments.
NETWORK_HMAC_KEY=change-me-to-a-long-random-hmac-key

# Offer-letter upload handling (private storage, TTL cleanup, max upload size in MB).
OFFER_STORAGE_DIR=backend/storage/offer_letters
OFFER_FILE_TTL_HOURS=24
OFFER_MAX_UPLOAD_MB=5
